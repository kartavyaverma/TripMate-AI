# ==============================================================================
# TripMate AI — Environment Configuration Template
# Copy this file to .env and configure your credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Configuration (Required)
# ------------------------------------------------------------------------------
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model IDs (Optional; these are the defaults). Each role uses its own
# model so they draw from separate rate-limit pools (free tier: 8K tokens/min
# and ~200K tokens/day per model).
#   GROQ_FAST_MODEL       guardrail, supervisor routing, destination extraction
#                         (short JSON only: qwen3.8-27b allows 1K output tokens/min)
#   GROQ_SPECIALIST_MODEL flight and budget analysis
#   GROQ_MODEL            draft itinerary and final polished plan
# GROQ_FAST_MODEL=qwen/qwen3.8-27b
# GROQ_SPECIALIST_MODEL=openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_TEMPERATURE=0.4
# Max prompt + output tokens per request (free tier TPM is 8000; raise on a paid tier)
# LLM_REQUEST_TOKEN_LIMIT=7600

# ------------------------------------------------------------------------------
# 2. Database / LangGraph Checkpointer
# ------------------------------------------------------------------------------
# PostgreSQL connection string for state checkpointing.
# (e.g. Supabase, Neon, Render, or local PostgreSQL container)
# Note: If PostgreSQL is unreachable, TripMate AI automatically falls back
# to in-memory checkpointer (MemorySaver).
DATABASE_URL=postgresql://postgres:password@localhost:5432/tripmate_db

# ------------------------------------------------------------------------------
# 3. Specialist Agent Tools & MCP Integrations (Optional)
# ------------------------------------------------------------------------------
# Tavily Search API key (used for web search and attraction/hotel discovery)
# Get yours from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# AviationStack API key (used for live flight information via uvx MCP)
# Get yours from https://aviationstack.com/
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# OpenWeather API key
# Get yours from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Weather MCP Mode: 'custom' (default: bundled local stdio MCP server that
# calls the OpenWeather REST API with OPENWEATHER_API_KEY) or 'remote'
# (a hosted weather MCP endpoint at OPENWEATHER_MCP_URL).
WEATHER_MCP_MODE=custom

# Only needed for WEATHER_MCP_MODE=remote. If left empty, the app uses the
# local server even when the mode is 'remote'.
# OPENWEATHER_MCP_URL=https://your-weather-mcp-host/mcp
# OPENWEATHER_MCP_TRANSPORT=streamable_http

# ------------------------------------------------------------------------------
# 4. Server Configuration (Optional)
# ------------------------------------------------------------------------------
DEFAULT_ORIGIN_DATA=India
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
